{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portfolio Template Configuration",
  "description": "Configuration file for customizing your portfolio site",
  "type": "object",
  "required": ["personal", "professional", "social"],
  "properties": {
    "personal": {
      "type": "object",
      "required": ["name", "title", "description", "email", "location", "availability", "branding"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Your full name"
        },
        "title": {
          "type": "string",
          "description": "Your professional title"
        },
        "description": {
          "type": "string",
          "description": "A brief description of your professional experience"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Your contact email"
        },
        "location": {
          "type": "string",
          "description": "Your location (city, state/country)"
        },
        "availability": {
          "type": "string",
          "description": "Your current availability status"
        },
        "branding": {
          "type": "string",
          "description": "Your personal branding (e.g., 'yourname.sh')"
        }
      }
    },
    "professional": {
      "type": "object",
      "required": ["yearsOfExperience", "bio", "personalBio", "focus", "interests"],
      "properties": {
        "yearsOfExperience": {
          "type": "number",
          "description": "Years of professional experience"
        },
        "bio": {
          "type": "string",
          "description": "Your professional biography"
        },
        "personalBio": {
          "type": "string",
          "description": "Your personal statement"
        },
        "focus": {
          "type": "string",
          "description": "Your technology focus areas"
        },
        "interests": {
          "type": "string",
          "description": "Your professional interests"
        }
      }
    },
    "social": {
      "type": "object",
      "required": ["github", "linkedin"],
      "properties": {
        "github": {
          "type": "string",
          "description": "Your GitHub username"
        },
        "linkedin": {
          "type": "string",
          "description": "Your LinkedIn username"
        },
        "discord": {
          "type": ["string", "null"],
          "description": "Your Discord user ID (optional)"
        },
        "whatsapp": {
          "type": ["string", "null"],
          "description": "Your WhatsApp number with country code (optional)"
        },
        "resumeUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL to your resume/CV"
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "Base URL for your blog API (if using the blog feature)"
        }
      }
    }
  }
}
