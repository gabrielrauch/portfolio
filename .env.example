# Portfolio Template - Environment Variables Example
# Copy this file to .env for local development

# API Configuration (Optional - for blog features)
# Set this if you want to override the API URL from template.config.json
# PUBLIC_API_URL=https://your-api.workers.dev

# Formspree Configuration (for contact form)
# Get your form endpoint from https://formspree.io
# PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Analytics (Optional)
# Uncomment and add your tracking IDs if using analytics
# PUBLIC_GA_ID=G-XXXXXXXXXX
# PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=your-token-here

# Note: Variables prefixed with PUBLIC_ are exposed to the browser
# Never put sensitive credentials in PUBLIC_ variables
