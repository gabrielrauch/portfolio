{
  "name": "portfolio-blog-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create portfolio-blog",
    "db:migrate": "wrangler d1 migrations apply portfolio-blog --local",
    "db:migrate:prod": "wrangler d1 migrations apply portfolio-blog",
    "db:seed": "wrangler d1 execute portfolio-blog --file=../database/seed.sql --local",
    "db:seed:prod": "wrangler d1 execute portfolio-blog --file=../database/seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "typescript": "^5.0.0",
    "wrangler": "^4.40.3"
  },
  "dependencies": {
    "@tsndr/cloudflare-worker-jwt": "^3.2.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "slugify": "^1.6.6"
  }
}
